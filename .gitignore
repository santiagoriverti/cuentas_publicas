# Excel/ZIP generados o sueltos: ignorados por defecto...
*.zip
*.xls
*.xlsx
# ...EXCEPTO las fuentes versionadas (datos publicos, repo autocontenido):
#   data/raw/        Excel originales de Hacienda (ZIP historico + meses sueltos nuevos)
#   data/reference/  IPC INDEC
!data/raw/*.zip
!data/raw/*.xls
!data/raw/*.xlsx
!data/reference/*.xlsx
# Copias duplicadas del contenido del ZIP (no se usan; se guardan solo localmente)
data/raw/_duplicados/

# Graficos y tablas generados por los notebooks (se regeneran en Colab/local)
*.png
*.tex

__pycache__/
*.py[cod]
.env
*.egg-info/
dist/
build/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Salidas de scripts/run_notebooks_local.py
_local_run/
